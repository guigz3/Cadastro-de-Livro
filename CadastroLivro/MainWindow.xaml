<Window x:Class="CadastroLivro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CadastroLivro"
        mc:Ignorable="d"
        Title="Cadastro de Livro" Height="300" Width="400">
    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F0F0F0" Offset="0"/>
                <GradientStop Color="#C8C8C8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Título"/>
            <TextBox x:Name="TxtTitulo"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Autor"/>
            <TextBox x:Name="TxtAutor"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Salvar" Click="BtnSalvar_Click" Width="100" HorizontalAlignment="Left"/>

        <TextBlock x:Name="TxtMensagem" Grid.Row="3" Margin="0,10,0,0" Foreground="Green"/>
    </Grid>
</Window>